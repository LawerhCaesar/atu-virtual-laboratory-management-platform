      "range": "1..15"
    },
    {
      "name": "WarmupEnrichment",
      "category": "calculated",
      "unit": "%",
      "range": "0..40"
    },
    {
      "name": "BatteryCompensation",
      "category": "calculated",
      "unit": "ms",
      "range": "0..1.2"
    },
    {
      "name": "InjectorPW",
      "category": "commanded",
      "unit": "ms",
      "range": "0..20"
    },
    {
      "name": "ClosedLoopActive",
      "category": "status",
      "unit": "state",
      "range": "0..1"
    },
    {
      "name": "TargetIdleRPM",
      "category": "calculated",
      "unit": "rpm",
      "range": "750..1200"
    },
    {
      "name": "RPMError",
      "category": "calculated",
      "unit": "rpm",
      "range": "signed"
    },
    {
      "name": "IdleControlDuty",
      "category": "commanded",
      "unit": "%",
      "range": "0..100"
    },
    {
      "name": "IgnitionTiming",
      "category": "commanded",
      "unit": "deg BTDC",
      "range": "-5..45"
    },
    {
      "name": "IdleActive",
      "category": "status",
      "unit": "state",
      "range": "0..1"
    },
    {
      "name": "ECT1Temp",
      "category": "calculated",
      "unit": "degC",
      "range": "-20..135"
    },
    {
      "name": "ECT2Temp",
      "category": "calculated",
      "unit": "degC",
      "range": "-20..135"
    },
    {
      "name": "SensorDifference",
      "category": "calculated",
      "unit": "degC",
      "range": "0..155"
    },
    {
      "name": "SensorDisagreement",
      "category": "status",
      "unit": "state",
      "range": "0..1"
    },
    {
      "name": "ControlTemperature",
      "category": "calculated",
