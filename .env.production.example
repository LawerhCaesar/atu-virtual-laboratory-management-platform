# Generate a fresh secret; never use example placeholder values in production.
ATU_DOMAIN=lab.example.edu
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=lab.example.edu
DJANGO_CSRF_TRUSTED_ORIGINS=https://lab.example.edu
DJANGO_TRUST_PROXY_HEADERS=true
POSTGRES_HOST=db
POSTGRES_DB=atu_virtual_lab
POSTGRES_USER=atu_virtual_lab
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_ADMIN_USER=atu_bootstrap
POSTGRES_ADMIN_PASSWORD=replace-with-a-separate-bootstrap-password
DJANGO_MEDIA_ROOT=/app/media
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
SESSION_IDLE_TIMEOUT_SECONDS=300
EVIDENCE_FILE_MAX_BYTES=20971520
EVIDENCE_SUBMISSION_MAX_BYTES=104857600
INTEGRATION_SHARED_SECRETS={}
INTEGRATION_RETURN_TOKEN_MAX_AGE_SECONDS=1800
INTEGRATION_CALLBACK_MAX_BYTES=1048576
