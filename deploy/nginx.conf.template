server {
    listen 80 default_server;
    server_name _;
    return 444;
}
server {
    listen 80;
    server_name ${ATU_DOMAIN};
    return 308 https://${ATU_DOMAIN}$request_uri;
}
server {
    listen 443 ssl default_server;
    server_name _;
    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    return 444;
}
server {
    listen 443 ssl;
    server_name ${ATU_DOMAIN};
    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 21m;
    client_body_timeout 30s;
    # Evidence is never served by a public directory alias.
    location ^~ /media/ { return 404; }
    location = /practicals/integrations/return/ {
        client_max_body_size 1m;
        proxy_pass http://web:8000;
        proxy_set_header Host ${ATU_DOMAIN};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
    }
    location / {
        proxy_pass http://web:8000;
        proxy_set_header Host ${ATU_DOMAIN};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 60s;
    }
}
